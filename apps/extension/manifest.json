{
  "manifest_version": 3,
  "name": "Capacity Monitor Collector",
  "version": "0.1.0",
  "description": "Reads only displayed credit and usage-limit values from your open provider tabs.",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["https://app.kilo.ai/*", "https://platform.openai.com/*", "https://platform.claude.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://console.x.ai/*", "https://gemini.google.com/*", "https://one.google.com/*", "https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Capacity Monitor", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
